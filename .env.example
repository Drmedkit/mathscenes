# Copy this file to .env (git-ignored) and fill in your own key. Only the audio tools (audio/*.py) use it,
# and only when they actually generate something: every tool also has a --dry mode that needs no key.
ELEVENLABS_API_KEY=

# optional: a voices file other than audio/voices.json / audio/voices.example.json
# MATHSCENES_VOICES=path/to/voices.json

# optional: ffmpeg when it is not on PATH
# FFMPEG=/path/to/ffmpeg
